# Liga a camada de mocks (MSW) — padrão: ligada, inclusive no build de demonstração.
VITE_ENABLE_MOCKS=true
# Cenário inicial dos mocks (ver src/mocks/scenarios.ts). A URL ?scenario=<id> tem prioridade.
VITE_MOCK_SCENARIO=default
# Base da API REST.
VITE_API_URL=/api
# Servidor Socket.IO. Com mocks, é um host fictício interceptado pelo MSW.
VITE_SOCKET_URL=https://realtime.greenmint.test
# Timeout das requisições HTTP (ms).
VITE_HTTP_TIMEOUT_MS=10000
